# ==============================================================================
# Vivado generated output -- directory-scoped so it cannot catch source files
# These are rebuilt from .xpr + .srcs. runs/ alone is ~5.5 MB of .dcp / .pb /
# .rpt / log churn that changes on every single build, which makes every diff
# unreadable and bloats history.
# ==============================================================================

/LessonProject.runs/
/LessonProject.cache/
/LessonProject.hw/
/.Xil/

# Simulation run output
/xsim.dir/
/xsim.jou
/xsim.log
/webtalk*
/vivado.log
/vivado.jou
*.backup.jou
*.backup.log

# ==============================================================================
# Build artifacts left outside the run directories
# ==============================================================================

*.ltx
*.mcs
!prj_out/*.mcs
*.wdb
*.wcfg

# ==============================================================================
# Local scratch
# ==============================================================================

_tmp_*/
_backup_*/
_m2check/
Thumbs.db
desktop.ini

# ==============================================================================
# Host side (Python bridge + DSH plugin)
# ==============================================================================

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# The plugin's compiled output is committed on purpose: the DSH loader imports
# lib/ directly and has no build step of its own. `src/` is the source of truth,
# so a stale lib/ is a real hazard -- rebuild with `npx tsc -p tsconfig.json` after editing.
# node_modules/ is never committed; the loader resolves peer packages from the
# profile instead.
host/dsh-plugin/node_modules/
